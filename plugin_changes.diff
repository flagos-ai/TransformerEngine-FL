+        right = torch.randn(K, N, dtype=dtype, device="npu")
+
+        npu_out = _run_generic_gemm(npu_backend, left, right, dtype)
+        ref_out = (left.cpu().float() @ right.cpu().float()).to(dtype)
+        assert_close(npu_out, ref_out, dtype, msg="gemm_large")
