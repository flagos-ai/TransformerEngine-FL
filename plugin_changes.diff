+        k_cos = tl.cos(tl.load(k_freqs + s_id_for_freqs * D2 + offs_d, mask=mask_d2, other=0.0))
+        k_sin = (
+            tl.sin(tl.load(k_freqs + s_id_for_freqs * D2 + sin_d, mask=mask_d2, other=0.0))
