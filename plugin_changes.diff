+            ), f"scale[{i}]: npu={npu_scale.item():.6e}, ref={ref_scale.item():.6e}"
+            assert torch.allclose(
+                npu_sinv, ref_sinv, atol=1e-5, rtol=1e-5
+            ), f"scale_inv[{i}]: npu={npu_sinv.item():.6e}, ref={ref_sinv.item():.6e}"
+
