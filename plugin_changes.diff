+        assert torch.allclose(
+            npu_D0, ref_D0, atol=atol, rtol=rtol
+        ), f"Group 0: max_diff={max_diff_0:.6e}"
+        assert torch.allclose(
+            npu_D1, ref_D1, atol=atol, rtol=rtol
+        ), f"Group 1: max_diff={max_diff_1:.6e}"
