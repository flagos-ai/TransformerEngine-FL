+
+
+def _bind_is_available(fn, is_available_fn):
+    """Wrap a function and bind _is_available attribute for OpImpl.is_available() check."""
+
+    @functools.wraps(fn)
+    def wrapper(*args, **kwargs):
+        return fn(*args, **kwargs)
+
+    wrapper._is_available = is_available_fn
+    return wrapper
+
+
+def register_builtins(registry) -> None:
+    """
+    Register all Enflame (VENDOR) operator implementations.
+
+    Args:
+        registry: Registry to register into
+    """
+    # Import Enflame backend to get all the wrapped tex functions
+    from .enflame import EnflameBackend
+
+    # Create a backend instance to access the methods
+    backend = EnflameBackend()
+
+    # Check if Enflame is available before registering
+    if not backend.is_available():
+        return
+
+    # Bind is_available to all methods
+    is_avail = backend.is_available
+
+    impls = [
+        # Normalization
+        OpImpl(
+            op_name="rmsnorm_fwd",
+            impl_id="vendor.enflame",
+            kind=BackendImplKind.VENDOR,
+            fn=_bind_is_available(backend.rmsnorm_fwd, is_avail),
+            vendor="ENFLAME",
+            priority=100,
+        ),
+        OpImpl(
+            op_name="rmsnorm_bwd",
+            impl_id="vendor.enflame",
+            kind=BackendImplKind.VENDOR,
