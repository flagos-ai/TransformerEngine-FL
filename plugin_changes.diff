+            amax,
+            scale_inv,
+            otype,
+            scale_offset,
+            amax_offset,
+            scale_inv_offset,
+        )
+
+    def bulk_overlap_ag_with_external_gemm(
+        self,
+        allgather_communicator: CommOverlap,
