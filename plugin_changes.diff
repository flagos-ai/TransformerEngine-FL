+retry_command() {
+    local attempts=$1
+    local delay_seconds=$2
+    shift 2
+
+    local attempt
+    for attempt in $(seq 1 "${attempts}"); do
+        if "$@"; then
+            return 0
+        fi
+        if [ "${attempt}" -lt "${attempts}" ]; then
+            echo "Command failed (attempt ${attempt}/${attempts}): $*"
+            echo "Retrying in ${delay_seconds}s..."
+            sleep "${delay_seconds}"
+        fi
+    done
+
+    echo "Command failed after ${attempts} attempts: $*"
+    return 1
+}
